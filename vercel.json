{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/series-vivatech-2026",
      "destination": "/series-tech-events",
      "permanent": true
    },
    {
      "source": "/en/series-vivatech-2026",
      "destination": "/en/series-tech-events",
      "permanent": true
    },
    {
      "source": "/ja/series-vivatech-2026",
      "destination": "/ja/series-tech-events",
      "permanent": true
    },
    {
      "source": "/th/series-vivatech-2026",
      "destination": "/th/series-tech-events",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
